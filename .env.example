# Dallas College Success Coach Chatbot - Local Environment Variables Example

# 1. Database Configuration (Supabase pgvector)
# Replace with your actual Supabase connection string. 
# Make sure it uses connection pooling (usually port 6543) if running serverless/Vercel.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# 2. AI Inference Engine APIs
# Get your free Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Next.js Public URL
# Used for widget cors configuration and absolute path resolve
NEXT_PUBLIC_API_URL="http://localhost:3000"
